{
  "name": "velobase-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "check": "pnpm check:env && pnpm test:env && pnpm lint && pnpm typecheck",
    "check:env": "node scripts/check-env.mjs",
    "test:env": "pnpm test:env:auth && pnpm test:env:drift",
    "test:env:auth": "node --test src/env-normalization.test.mjs",
    "test:env:drift": "node --test scripts/check-env.test.mjs",
    "docker:up": "docker compose --profile stripe up -d",
    "docker:down": "docker compose --profile stripe down --remove-orphans",
    "docker:db:up": "docker compose up -d postgres redis",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "node services/demo/seed-admin.mjs",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' eslint .",
    "lint:fix": "NODE_OPTIONS='--max-old-space-size=4096' eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "api:dev": "tsx watch services/api/src/index.ts",
    "api:prod": "node --import tsx services/api/src/index.ts",
    "worker:dev": "tsx watch services/worker/src/index.ts",
    "worker:prod": "node --import tsx services/worker/src/index.ts",
    "dev:all": "tsx watch src/server/standalone.ts",
    "dev:local": "node services/demo/start.mjs --local",
    "start:all": "node --import tsx src/server/standalone.ts",
    "update:disposable-domains": "tsx scripts/update-disposable-domains.ts",
    "dev:web": "pnpm --filter @velobase/web dev",
    "build:web": "pnpm --filter @velobase/web build",
    "check:web": "pnpm --filter @velobase/web check",
    "dev:desktop": "pnpm --filter @velobase/desktop dev",
    "build:desktop": "pnpm --filter @velobase/desktop build",
    "check:desktop": "pnpm --filter @velobase/desktop check",
    "package:desktop": "pnpm --filter @velobase/desktop package",
    "dev:mobile": "pnpm --filter @velobase/mobile dev",
    "build:mobile": "pnpm --filter @velobase/mobile build",
    "check:mobile": "pnpm --filter @velobase/mobile check",
    "config:mobile": "pnpm --filter @velobase/mobile run config",
    "check:packages": "pnpm --filter @velobase/contracts --filter @velobase/api-client check",
    "check:architecture": "node --test scripts/architecture/*.test.mjs",
    "test:platforms": "pnpm --filter @velobase/contracts --filter @velobase/api-client --filter @velobase/desktop --filter @velobase/mobile test && pnpm exec node --import tsx --test apps/web/tests/*.test.ts",
    "test:existing": "SKIP_ENV_VALIDATION=true NEXT_PHASE=phase-production-build node --import tsx --experimental-test-module-mocks --test src/server/auth/email-code-utils.test.ts src/server/billing/routers/billing-router.test.ts",
    "check:api": "pnpm --filter @velobase/api-service check",
    "check:worker": "pnpm --filter @velobase/worker-service check",
    "test:services": "SKIP_ENV_VALIDATION=true NEXT_PHASE=phase-production-build node --import tsx --test services/*/tests/*.test.ts",
    "test:runtime": "node scripts/test-service-runtime.mjs"
  },
