{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["react"]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*.ts",
    "config.ts",
    "app.config.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
