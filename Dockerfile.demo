FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.12.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services

RUN --mount=type=cache,id=harness-preview-pnpm,target=/pnpm/store \
    pnpm --filter velobase-harness... install --frozen-lockfile --ignore-scripts --store-dir /pnpm/store

COPY . .
RUN pnpm exec prisma generate

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3003
CMD ["node", "services/demo/start.mjs"]
